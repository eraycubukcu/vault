@startuml 07-seq-create-server
title Sunucu Oluşturma Akışı
autonumber

actor Kullanıcı
participant "CreateServerModal /\nInitialModal" as Modal
participant "FileUpload\n(UploadDropzone)" as FU
participant "/api/uploadthing\n(serverImage)" as UTApi
participant "UploadThing" as UT
participant "POST /api/servers" as API
participant "currentProfile()" as CP
database "MongoDB" as DB

Kullanıcı -> Modal : "Sunucu oluştur" (useModal.onOpen("createServer"))
Kullanıcı -> FU : sunucu görseli seç
FU -> UTApi : middleware → handleAuth()
UTApi --> FU : yetkili (userId)
FU -> UT : dosyayı yükle (image, ≤4MB, 1 adet)
UT --> FU : url
FU --> Modal : form.imageUrl = url
Kullanıcı -> Modal : isim gir + "Oluştur"
Modal -> Modal : zod doğrulama (name, imageUrl)
Modal -> API : axios.post({ name, imageUrl })
API -> CP : currentProfile()
CP --> API : profile
alt profile yok
  API --> Modal : 401 Unauthorized
else
  API -> DB : server.create({\n  profileId, name, imageUrl,\n  inviteCode: uuidv4(),\n  channels.create: [{ name: "general" }],\n  members.create: [{ role: ADMIN }] })
  DB --> API : server
  API --> Modal : 200 server
  Modal -> Modal : form.reset(), router.refresh(), onClose()
end
@enduml
